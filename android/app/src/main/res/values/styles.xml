<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!--
      Moonlight AI Splash Screen (legacy Android < 12 splash via window background).
      On Android 12+ the SplashScreen API uses the launcher icon automatically.
      Background: brand dark (#0F1014) matching the app's dark background.
    -->
    <style name="SplashTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">#0F1014</item>
        <item name="android:navigationBarColor">#0F1014</item>
    </style>

</resources>
